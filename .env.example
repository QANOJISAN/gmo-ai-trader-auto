# AI API Keys (どちらか一方、または両方を設定。未設定時はルールベース判定フォールバックが動作します)
GEMINI_API_KEY=your_gemini_api_key_here
# 有料枠(Paid Tier)では gemini-4-Argon-High (gemini-4-argon) が利用可能。無料枠(Free Tier)では gemini-3.8-flash が最上位モデルとして動作します
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=HIGH

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# AI Provider ("gemini" | "openai" | "rule_based")
AI_PROVIDER=gemini

# 通知設定（任意：設定されている場合のみ通知を送信します）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here

# 対象銘柄
# "ALL" または未指定の場合は GMOコイン全現物銘柄からスプレッド(<=0.35%)・24h売買代金で動的スクリーニング（計8〜10銘柄）
# 個別指定する場合はカンマ区切り（例: BTC,ETH,XRP,SOL,DOGE）
TARGET_SYMBOLS=ALL
MAX_SCREENED_SYMBOLS=10
MAX_SPREAD_PCT=0.35

# ==========================================
# v2 24h Full-Automated Trading Settings
# ==========================================
# EXECUTION_MODE: DRY_RUN (仮想約定ペーパートレード) / LIVE (GMO Private API 実発注)
# ※初期値は必ず DRY_RUN とし、v1停止＆移行完了後に LIVE へ切り替えます
EXECUTION_MODE=DRY_RUN
GMO_API_KEY=
GMO_API_SECRET=
FAST_LOOP_SEC=15
RADAR_LOOP_SEC=900
ORDER_EXPIRY_HOURS=4
MAX_DAILY_TRADES=4
MAX_CONSECUTIVE_API_ERRORS=5
